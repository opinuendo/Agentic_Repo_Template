# Shared editor settings, honored by most editors and many AI tools (ADR-0008). https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Two trailing spaces are a line break in Markdown, so don't strip them.
[*.md]
trim_trailing_whitespace = false

# Makefiles require tabs.
[Makefile]
indent_style = tab
